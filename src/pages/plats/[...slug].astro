---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import scans from '../../data/plats-scans.json';

export async function getStaticPaths() {
  const entries = await getCollection('plats');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Fiches data-driven : familles + communauté viennent du snapshot des scans.
const snap = d.dataKey ? (scans.plats as Record<string, any>)[d.dataKey] : null;
const familles = snap?.familles ?? d.familles;
const communaute = snap?.communaute ?? d.communaute;
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Plats', href: '/plats/' },
  { label: d.title, href: `/plats/${entry.id}/` },
];
---
<Article kind="plat" slug={entry.id} title={d.title} description={d.description}
  answer={d.answer} updated={d.updated} reviewedBy={d.reviewedBy} faq={d.faq}
  sources={d.sources} familles={familles} equilibrer={d.equilibrer} communaute={communaute} draft={d.draft} crumbs={crumbs}>
  <Content />
</Article>
