---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const entries = await getCollection('plats');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Plats', href: '/plats/' },
  { label: d.title, href: `/plats/${entry.id}/` },
];
---
<Article kind="plat" slug={entry.id} title={d.title} description={d.description}
  answer={d.answer} updated={d.updated} reviewedBy={d.reviewedBy} faq={d.faq}
  sources={d.sources} familles={d.familles} equilibrer={d.equilibrer} draft={d.draft} crumbs={crumbs}>
  <Content />
</Article>
